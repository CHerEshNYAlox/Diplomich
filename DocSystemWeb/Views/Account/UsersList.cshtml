@model List<DocSystemWeb.Models.UserModel>
@{
    ViewData["Title"] = "Сотрудники";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>Список сотрудников</h2>
    <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addUserModal">Добавить сотрудника</button>
</div>

<table class="table table-bordered table-hover bg-white shadow-sm align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-center">ФИО</th>
            <th class="text-center">Логин</th>
            <th class="text-center">Должность</th>
            <th class="text-center">Роль в системе</th>
            @if (User.IsInRole("Admin"))
            {
                <th style="width: 150px;" class="text-center">Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td class="text-center fw-bold">@user.FullName</td>
                <td class="text-center">@user.Login</td>
                <td class="text-center">@user.Position</td>
                <td class="text-center">
                    <span class="badge bg-@(user.Role == "Admin" ? "danger" : user.Role == "Manager" ? "primary" : "secondary")">
                        @(user.Role == "Admin" ? "Администратор" : user.Role == "Manager" ? "Руководитель" : "Пользователь")
                    </span>
                </td>
                @if (User.IsInRole("Admin"))
                {
                    <td class="text-center">
                        <div class="d-flex flex-column align-items-center mt-1">

                            @if (user.Role == "Admin" && !User.IsInRole("Admin"))
                            {
                                <span class="text-muted small">Нет доступа</span>
                            }
                            else
                            {
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-primary btn-unified rounded-pill shadow-sm mb-2">Изменить</a>
                            }

                            @if (user.Login != User.Identity.Name)
                            {
                                <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-outline-danger btn-unified rounded-pill shadow-sm" onclick="return confirm('Удалить пользователя?')">Удалить</a>
                            }

                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Новый сотрудник</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddUser" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="fw-bold">ФИО:</label>
                        <input type="text" name="FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Логин:</label>
                        <input type="text" name="Login" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Пароль:</label>
                        <input type="text" name="Password" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Должность:</label>
                        <input type="text" name="Position" class="form-control" placeholder="Например: Системный аналитик" required />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Права доступа:</label>
                        <select name="Role" class="form-select">
                            <option value="User">Пользователь</option>
                            <option value="Manager">Руководитель</option>
                            @if (User.IsInRole("Admin"))
                            {
                                <option value="Admin">Администратор (Полный доступ)</option>
                            }
                        </select>
                        @if (User.IsInRole("Manager"))
                        {
                            <small class="text-danger">Вы не можете выдавать права Администратора.</small>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Создать аккаунт</button>
                </div>
            </form>
        </div>
    </div>
</div>