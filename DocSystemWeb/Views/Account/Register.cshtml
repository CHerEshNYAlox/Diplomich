@{
    ViewData["Title"] = "Регистрация пользователя";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white text-center">
                <h4>Регистрация сотрудника</h4>
            </div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">@ViewBag.Success</div>
                }

                <form asp-action="Register" method="post">
                    <h5 class="text-muted border-bottom pb-2 mb-3">Личные данные</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label>Фамилия:</label>
                            <input type="text" name="lastName" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Имя:</label>
                            <input type="text" name="firstName" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Отчество:</label>
                            <input type="text" name="middleName" class="form-control" />
                        </div>
                    </div>

                    <h5 class="text-muted border-bottom pb-2 mb-3 mt-2">Данные для входа</h5>
                    <div class="mb-3">
                        <label>Логин (для входа в систему):</label>
                        <input type="text" name="username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Пароль (мин. 6 символов, буквы + цифры):</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label>Уровень доступа:</label>
                        <select name="role" class="form-select">
                            <option value="User">Обычный пользователь</option>
                            <option value="Admin">Администратор</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Зарегистрировать</button>
                </form>
                <div class="mt-3 text-center">
                    <a asp-controller="Document" asp-action="Index" class="btn btn-link text-decoration-none">Вернуться к списку</a>
                </div>
            </div>
        </div>
    </div>
</div>