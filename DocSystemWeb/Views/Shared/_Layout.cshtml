<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DocFlowSystem</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1055;
        }

        iframe.preview-frame {
            width: 100%;
            height: 65vh;
            border-radius: 12px;
            border: none;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
            background-color: white;
        }

        [data-bs-theme="dark"] iframe.preview-frame {
            background-color: #2b3035;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm mb-4 px-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Document" asp-action="Index">
                    <span style="font-size: 1.2rem; letter-spacing: -0.5px;">DocFlowSystem</span>
                </a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Document" asp-action="Index">Реестр документов</a></li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item"><a class="nav-link fw-semibold text-primary ms-3" asp-controller="Account" asp-action="UsersList">Сотрудники</a></li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary btn-sm me-4 rounded-pill px-3 glass-panel" id="themeToggle" title="Переключить тему">
                            🌓 Тема
                        </button>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="navbar-text me-3 text-end" style="line-height: 1.1;">
                                <strong class="d-block" style="font-size: 0.95rem;">@User.FindFirst("FullName")?.Value</strong>
                                <small class="text-muted" style="font-size: 0.75rem;">@User.FindFirst("Position")?.Value</small>
                                <span class="badge bg-@(User.IsInRole("Admin") ? "danger" : User.IsInRole("Manager") ? "primary" : "secondary") ms-1 rounded-pill">
                                    @(User.IsInRole("Admin") ? "Администратор" : User.IsInRole("Manager") ? "Руководитель" : "Пользователь")
                                </span>
                            </span>
                            <a class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm" asp-controller="Account" asp-action="Logout">Выйти</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 fade-in-content">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer mt-auto">
        <div class="container d-flex flex-column align-items-center justify-content-center">
            <span class="fw-bold" style="font-size: 1.1rem;">DocFlowSystem &copy; 2026</span>
            <small class="text-muted mt-1">Создано с любовью вайб кодингом</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div class="toast-container">
        @if (TempData["SuccessNotification"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show glass-panel" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body fw-bold">@TempData["SuccessNotification"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Закрыть"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorNotification"] != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show glass-panel" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body fw-bold">@TempData["ErrorNotification"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Закрыть"></button>
                </div>
            </div>
        }
    </div>

    <script>
        const toggleBtn = document.getElementById('themeToggle');
        const htmlElement = document.documentElement;

        const currentTheme = localStorage.getItem('theme') || 'light';
        htmlElement.setAttribute('data-bs-theme', currentTheme);

        toggleBtn.addEventListener('click', () => {
            const newTheme = htmlElement.getAttribute('data-bs-theme') === 'light' ? 'dark' : 'light';
            htmlElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });

        setTimeout(() => {
            const toasts = document.querySelectorAll('.toast');
            toasts.forEach(t => t.classList.remove('show'));
        }, 5000);
    </script>
</body>
</html>